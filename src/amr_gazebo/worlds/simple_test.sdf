<?xml version="1.0"?>
<!--
  Depósito simple de prueba (20 x 14 m) con:
    - muros perimetrales y racks
    - una estación de palet elevada con un palet EUR cargado

  Estación: el palet se apoya solo en sus extremos cortos (ménsulas de 0.10 m).
  Queda un hueco libre de 1.00 m (x) y 0.45 m de altura. El AMR (0.80 m de
  ancho) entra girado 90° respecto al palet, se centra, eleva y retira el palet.
-->
<sdf version="1.10">
  <world name="simple_test">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- ===== Suelo ===== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.45 0.45 0.47 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Muros perimetrales ===== -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>0 7 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        <visual name="north_v"><pose>0 7 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
        <collision name="south"><pose>0 -7 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -7 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
        <collision name="east"><pose>10 0 1.5 0 0 0</pose><geometry><box><size>0.2 14 3</size></box></geometry></collision>
        <visual name="east_v"><pose>10 0 1.5 0 0 0</pose><geometry><box><size>0.2 14 3</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
        <collision name="west"><pose>-10 0 1.5 0 0 0</pose><geometry><box><size>0.2 14 3</size></box></geometry></collision>
        <visual name="west_v"><pose>-10 0 1.5 0 0 0</pose><geometry><box><size>0.2 14 3</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== Racks (bloques de estanterías) ===== -->
    <model name="rack_row_1">
      <static>true</static>
      <pose>-4 4.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 1.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 1.1 2.5</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.1 0.3 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="rack_row_2">
      <static>true</static>
      <pose>-4 -4.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 1.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 1.1 2.5</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.1 0.3 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== Estación de palet ===== -->
    <!-- Palet orientado con su lado de 1.2 m en X. Ménsulas bajo los extremos
         cortos (x = ±0.55). Hueco libre entre ménsulas: 1.00 m en X. -->
    <model name="pallet_station_1">
      <static>true</static>
      <pose>5 0 0 0 0 0</pose>
      <link name="link">
        <!-- Ménsulas (largueros) de apoyo, cara superior a 0.45 m -->
        <collision name="ledge_e"><pose>0.60 0 0.43 0 0 0</pose><geometry><box><size>0.20 1.0 0.04</size></box></geometry></collision>
        <visual name="ledge_e_v"><pose>0.60 0 0.43 0 0 0</pose><geometry><box><size>0.20 1.0 0.04</size></box></geometry>
          <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material></visual>
        <collision name="ledge_w"><pose>-0.60 0 0.43 0 0 0</pose><geometry><box><size>0.20 1.0 0.04</size></box></geometry></collision>
        <visual name="ledge_w_v"><pose>-0.60 0 0.43 0 0 0</pose><geometry><box><size>0.20 1.0 0.04</size></box></geometry>
          <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material></visual>
        <!-- Patas en el exterior de la huella del palet -->
        <collision name="leg_1"><pose>0.65 0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry></collision>
        <visual name="leg_1_v"><pose>0.65 0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry>
          <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material></visual>
        <collision name="leg_2"><pose>0.65 -0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry></collision>
        <visual name="leg_2_v"><pose>0.65 -0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry>
          <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material></visual>
        <collision name="leg_3"><pose>-0.65 0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry></collision>
        <visual name="leg_3_v"><pose>-0.65 0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry>
          <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material></visual>
        <collision name="leg_4"><pose>-0.65 -0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry></collision>
        <visual name="leg_4_v"><pose>-0.65 -0.45 0.205 0 0 0</pose><geometry><box><size>0.08 0.08 0.41</size></box></geometry>
          <material><ambient>0.9 0.4 0.05 1</ambient><diffuse>0.9 0.4 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Palet EUR (1200 x 800 x 144 mm) con carga de 800 kg -->
    <model name="euro_pallet_1">
      <pose>5 0 0.45 0 0 0</pose>
      <link name="pallet">
        <pose>0 0 0.072 0 0 0</pose>
        <inertial>
          <mass>25.0</mass>
          <inertia><ixx>1.38</ixx><iyy>3.04</iyy><izz>4.33</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>1.2 0.8 0.144</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 0.144</size></box></geometry>
          <material><ambient>0.72 0.55 0.32 1</ambient><diffuse>0.72 0.55 0.32 1</diffuse></material></visual>
      </link>
      <link name="cargo">
        <pose>0 0 0.544 0 0 0</pose>
        <inertial>
          <mass>800.0</mass>
          <inertia><ixx>85.3</ixx><iyy>149.3</iyy><izz>138.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>1.1 0.75 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.1 0.75 0.8</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.6 0.45 0.25 1</diffuse></material></visual>
      </link>
      <joint name="strapped" type="fixed">
        <parent>pallet</parent>
        <child>cargo</child>
      </joint>
    </model>

  </world>
</sdf>
