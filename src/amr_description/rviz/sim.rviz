Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: LidarFront
      Enabled: true
      Topic:
        Value: /lidar_front/scan
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/LaserScan
      Name: LidarRear
      Enabled: true
      Topic:
        Value: /lidar_rear/scan
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 60; 160; 255
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 50
      Shape:
        Value: Arrow
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Width: 1400
  Height: 900
