<?xml version="1.0"?>
<!--
  Interfaz ros2_control del AMR.
    - 4 ruedas: comando de velocidad, estado posición/velocidad (encoders)
    - Elevador: comando de posición en lift_joint (altura de elevación 0 .. 1 m).
      Las etapas telescópicas son visuales y no pasan por ros2_control.

  use_sim=true  → gz_ros2_control (Gazebo Harmonic)
  use_sim=false → mock_components (prueba de controladores sin hardware)
  Más adelante se añadirá aquí el driver de los variadores reales.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="amr_ros2_control" params="use_sim controllers_file">

    <ros2_control name="AmrSystem" type="system">
      <hardware>
        <xacro:if value="${use_sim}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:unless>
      </hardware>

      <xacro:macro name="wheel_interface" params="prefix">
        <joint name="${prefix}_wheel_joint">
          <command_interface name="velocity">
            <param name="min">${-wheel_max_velocity}</param>
            <param name="max">${wheel_max_velocity}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:wheel_interface prefix="front_left"/>
      <xacro:wheel_interface prefix="front_right"/>
      <xacro:wheel_interface prefix="rear_left"/>
      <xacro:wheel_interface prefix="rear_right"/>

      <!-- Elevador: posición de lift_joint = altura de elevación [m].
           Se manda por VELOCIDAD (lift_controller cierra el lazo de posición con
           PID): el modo posición de gz_ros2_control lo dejaba bloqueado. -->
      <joint name="lift_joint">
        <command_interface name="velocity">
          <param name="min">-0.1</param>
          <param name="max">0.1</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <xacro:if value="${use_sim}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controllers_file}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
